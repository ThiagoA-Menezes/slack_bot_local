# Slack Bot OAuth Token
SLACK_BOT_TOKEN=xoxb-your-token-here

# Ollama (local — no account needed)
OLLAMA_URL=http://localhost:11434
OLLAMA_GEN_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenSearch connection
OPENSEARCH_URL=http://localhost:9200
# Leave blank if security is disabled (default local Podman setup)
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# How many messages to accumulate per summary chunk
BATCH_SIZE=50

# Number of context entries passed to the RAG Q&A layer
N_CONTEXT_ENTRIES=5

# Semantic response cache — cosine similarity threshold for a cache hit.
# Range: 0.0 (match everything) to 1.0 (exact match only).
# 0.92 is a sensible default — adjust lower to be more permissive.
CACHE_SIMILARITY_THRESHOLD=0.92
